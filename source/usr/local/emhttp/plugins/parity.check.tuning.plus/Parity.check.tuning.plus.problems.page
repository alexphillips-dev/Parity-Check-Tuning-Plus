<script>
var totalSectors = <?=($parityTuningPlusSize * 2)?>;
var noParity = <?=($parityTuningPlusNoParity ? 'true' : 'false')?>;
var myWin;
var pctProblemActive = <?=($parityTuningPlusActive ? 'true' : 'false')?>;

$(function() {
  if ( typeof caPluginUpdateCheck === "function" ) {
    caPluginUpdateCheck("parity.check.tuning.plus.plg",{element:".pluginUpdate"});
  }
});

$(document).ready(function(){
  var oForm = document.getElementById('parityProblemPlusPage');
  var isDisabled = pctProblemActive || noParity;
  oForm.parityProblemPlusType.disabled         = isDisabled;
  oForm.parityProblemPlusStartSector.disabled  = isDisabled;  
  oForm.parityProblemPlusStartPercent.disabled = isDisabled;  
  oForm.parityProblemPlusEndSector.disabled    = isDisabled;  
  oForm.parityProblemPlusEndPercent.disabled   = isDisabled;  
  oForm.parityProblemPlusCorrect.disabled      = isDisabled;
  setProblemType(oForm);
  if (pctProblemActive) setTimeout(refreshPage, 1000 * 30);
});

function refreshPage() {
    window.location.reload(true);
}

function setProblemType(form) { 
    if (form.parityProblemPlusType.value == "sector") {
        document.getElementById('parityProblemPlusSectorStart').style.display  = "inline";
        document.getElementById('parityProblemPlusSectorEnd').style.display    = "inline";
        document.getElementById('parityProblemPlusPercentStart').style.display = "none";
        document.getElementById('parityProblemPlusPercentEnd').style.display   = "none";
    } else {
        document.getElementById('parityProblemPlusPercentStart').style.display = "inline";
        document.getElementById('parityProblemPlusPercentEnd').style.display   = "inline";
        document.getElementById('parityProblemPlusSectorStart').style.display  = "none";
        document.getElementById('parityProblemPlusSectorEnd').style.display    = "none";
    }
	checkStartEnd(form);
}
function checkStartEnd(form, showError = false) {
    const decimal = /^(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)$/;
    const percent = form.parityProblemPlusType.value === 'percent';
    const first = percent ? form.parityProblemPlusStartPercent.value : form.parityProblemPlusStartSector.value;
    const last = percent ? form.parityProblemPlusEndPercent.value : form.parityProblemPlusEndSector.value;
    const format = percent ? decimal : /^(0|[1-9][0-9]*)$/;
    const limit = percent ? 100 : totalSectors;
    const valid = !pctProblemActive && !noParity && totalSectors > 0
        && format.test(first) && format.test(last)
        && Number.isFinite(Number(first)) && Number.isFinite(Number(last))
        && Number(first) >= 0 && Number(last) > Number(first) && Number(last) <= limit;
    form.elements['#apply'].disabled = !valid;
    if (!valid && showError) {
        swal({title: <?=pctJ('Invalid check range')?>,
              text: <?=pctJ('Choose a start point and a larger end point within the disk')?>, icon: 'error'});
    }
    return valid;
}

function changeProblemStartSector(form) {
    var v = form.parityProblemPlusStartSector.value / totalSectors * 100;
    updateIfChanged(form.parityProblemPlusStartPercent, v.toFixed(1));
    checkStartEnd(form);

}

function updateIfChanged(fld, newVal) {
    if (fld.value != newVal) fld.value = newVal;
}

function changeProblemStartPercent(form) {
    var v1 = Number(form.parityProblemPlusStartPercent.value);
    if (!Number.isFinite(v1)) return checkStartEnd(form);
    updateIfChanged (form.parityProblemPlusStartPercent, v1);
    var v2 = Math.floor(parseFloat(v1)/100 * totalSectors);
    updateIfChanged (form.parityProblemPlusStartSector, v2);
    checkStartEnd(form);
}


function changeProblemEndSector(form) {
    var v = form.parityProblemPlusEndSector.value / totalSectors * 100;
    updateIfChanged (form.parityProblemPlusEndPercent, v.toFixed(1));
    checkStartEnd(form);
}

function changeProblemEndPercent(form) {
    var v1 = Number(form.parityProblemPlusEndPercent.value);
    if (!Number.isFinite(v1)) return checkStartEnd(form); 
    updateIfChanged (form.parityProblemPlusEndPercent, v1);
    var v2 = Math.ceil(v1/100 * totalSectors);
    updateIfChanged (form.parityProblemPlusEndSector, v2);
    checkStartEnd(form);
}


// try to center popup relative to Unraid browser window

function positionPopup() {
    if (!myWin) return;
	var left = window.screenX + 300;
	var top  = window.screenY + 200;
	myWin.moveBy(left,top);
	myWin.focus();
}


</script>

