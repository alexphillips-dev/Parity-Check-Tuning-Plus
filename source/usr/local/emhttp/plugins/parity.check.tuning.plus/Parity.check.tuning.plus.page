    me.value="0";
<?endif;?>
}

function checkTimeRange(form) {
	var resumeTime = Number((form.parityTuningPlusResumeHour.value) * 60) + Number(form.parityTuningPlusResumeMinute.value);
	var pauseTime  = Number((form.parityTuningPlusPauseHour.value) * 60)  + Number(form.parityTuningPlusPauseMinute.value);
    if (form.parityTuningPlusFrequency.value === '2') {
        resumeTime += Number(form.parityTuningPlusResumeDay.value)*1440;
        pauseTime += Number(form.parityTuningPlusPauseDay.value)*1440;
    }
    var difference = pauseTime - resumeTime;
	if (difference == 0) {
		swal({title: <?=pctJ('Pause and Resume times?')?>,
			text:<?=pctJ('The Pause and Resume times cannot be identical.')?>,
			icon:"error"});
		form.elements['#apply'].disabled = true;
		return false;
	}
    form.elements['#apply'].disabled = false;
    if ( difference < 0) difference += (form.parityTuningPlusFrequency.value === '2' ? 7 : 1) * 1440;
	if (difference > (12 * 60) ) {
		swal({title: <?=pctJ('Pause and Resume times?')?>,
			  text:<?=pctJ('The Pause and Resume times would give an increment length of more than 12 hours which is unusual.  Are you sure you these are the right way around?')?>,
			  icon:"warning"});
	}
    return true;
}

