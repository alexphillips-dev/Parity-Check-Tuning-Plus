  } else {
    document.getElementById('parityTuningPlusIncrementDisplay').style.display = "inline"; 
    // Hide show options that depend on frequency selection
    switch (form.parityTuningPlusFrequency.value) {
	  case "1": // custom
		document.getElementById('parityTuningPlusCustomResume').style.display = "inline"; 
		document.getElementById('parityTuningPlusCustomPause').style.display  = "inline";
		document.getElementById('parityTuningPlusPauseDisplay').style.display  = "none";
	    document.getElementById('parityTuningPlusResumeDisplay').style.display  = "none";
		break;
	  case "2": // weekly
	  case "0": // daily)
		document.getElementById('parityTuningPlusCustomResume').style.display = "none";
		document.getElementById('parityTuningPlusCustomPause').style.display  = "none";
		document.getElementById('parityTuningPlusResumeDisplay').style.display = "inline";
		document.getElementById('parityTuningPlusPauseDisplay').style.display  = "inline";
		if (form.parityTuningPlusFrequency.value == '0') {
			document.getElementById('parityTuningPlusDayResume').style.display = "none";
			document.getElementById('parityTuningPlusDayPause').style.display  = "none";
		} else {
			document.getElementById('parityTuningPlusDayResume').style.display = "inline";
			document.getElementById('parityTuningPlusDayPause').style.display  = "inline";
		}
		break;
	}	 
  }

  // Hide Notifications for background tasks unless being monitored
  document.getElementById('parityTuningPlusBackgroundDisplay').style.display  = 
  ((form.parityTuningPlusMover.value == "0") && (form.parityTuningPlusBackup.value == "0")) ? "none":"inline";

  // Hide heat temperature setting unless monitoring heat for pause/resume 
  document.getElementById('parityTuningPlusHeatDisplay').style.display = 
