function normalizedCron(value) {
    if (/[\r\n\x00]/.test(value)) return false;
    const fields = value.trim().toLowerCase().split(/[ \t]+/);
    if (fields.length !== 5) return false;
    const bounds = [[0,59],[0,23],[1,31],[1,12],[0,7]];
    for (let index=0; index<5; index++) {
        const names = index===3 ? ['jan','feb','mar','apr','may','jun','jul','aug','sep','oct','nov','dec'] : index===4 ? ['sun','mon','tue','wed','thu','fri','sat'] : [];
        names.forEach((name,number)=>{fields[index]=fields[index].replaceAll(name,String(number+(index===3?1:0)));});
        for (const part of fields[index].split(',')) {
            const match = part.match(/^(\*|[0-9]+(?:-[0-9]+)?)(?:\/([0-9]+))?$/);
            if (!match || (match[2] && (+match[2]<1 || +match[2]>bounds[index][1]))) return false;
            if (match[2] && match[1]!=='*' && !match[1].includes('-')) return false;
            if (match[1]==='*') continue;
            const range=match[1].split('-').map(Number);
            if (range.some(n=>n<bounds[index][0] || n>bounds[index][1]) || (range.length===2 && range[0]>range[1])) return false;
        }
    }
    return fields.join(' ');
}

function checkCustom(fld) {
    if (normalizedCron(fld.value) === false) {
        swal({title: <?=pctJ('Error in custom entry')?>,
              text: <?=pctJ('A crontab entry should have 5 space-separated values defining the minutes, hour, day of the month, month, day of the week.  Click on the crontab link to get more details on valid formats.')?>,
              icon:"error"});
		// Disable Apply button as saving invalid Custom entry will cause problems later
		fld.form.elements['#apply'].disabled = true;
		return false;
    } 
	fld.form.elements['#apply'].disabled = false;
	return true;
}

function checkCustomOptions(form) {
    const increments = ['Manual','Scheduled','Automatic','Clear','Recon'].some(key=>form['parityTuningPlus'+key].value==='1');
    if (!increments) return true;
    if (form.parityTuningPlusFrequency.value !== '1') return checkTimeRange(form);
    const pause = form.parityTuningPlusPauseCustom;
    const resume = form.parityTuningPlusResumeCustom;
    if (!checkCustom(pause) || !checkCustom(resume)) return false;
    if (normalizedCron(pause.value) === normalizedCron(resume.value)) {
        swal({title: <?=pctJ('Pause and Resume times?')?>,
              text: <?=pctJ('The Pause and Resume custom times cannot be identical.')?>, icon: 'error'});
        form.elements['#apply'].disabled = true;
        return false;
    }
    return true;
}

function checkNotifications (me) {
<?if (!isset($dynamixCfg['notify']['system']) || $dynamixCfg['notify']['system'] == "" ): ?>
